{
  "private": true,
  "scripts": {
    "build": "max build",
    "dev": "max dev",
    "format": "prettier --cache --write .",
    "postinstall": "max setup",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "prepare": "husky install",
    "server": "node ./scripts/start.js dev",
    "setup": "max setup",
    "start": "node ./scripts/start.js",
    "start:dev": "node ./scripts/start.js dev",
    "start:prod": "node ./scripts/start.js prod",
    "start:test": "node ./scripts/start.js test",
    "start:uat": "node ./scripts/start.js uat",
    "stylelint": "stylelint \"src/**/*.{css,less,scss}\" --allow-empty-input",
    "stylelint:fix": "stylelint \"src/**/*.{css,less,scss}\" --fix",
    "switch-env": "node ./scripts/switch-admin-env.js"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{css,less,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,css,less,scss,ts,tsx,js,jsx}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/icons": "^5.0.1",
    "@ant-design/pro-components": "^2.4.4",
    "@antv/g2-extension-plot": "0.2.2",
    "@umijs/max": "^4.6.35",
    "antd": "^5.4.0",
    "dayjs": "^1.11.8",
    "file-saver": "^2.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.0",
    "@commitlint/config-conventional": "^17.7.0",
    "@types/react": "^18.0.33",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "chalk": "^5.3.0",
    "commitizen": "^4.3.0",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "^3.1.0",
    "husky": "^9",
    "inquirer": "^9.2.7",
    "lint-staged": "^13.2.0",
    "ora": "^6.1.2",
    "playwright": "1.39.0",
    "postcss-less": "^6.0.0",
    "prettier": "^2.8.7",
    "prettier-plugin-organize-imports": "^3.2.2",
    "prettier-plugin-packagejson": "^2.4.3",
    "stylelint": "^15.10.0",
    "stylelint-config-standard": "^32.0.0",
    "typescript": "^5.0.3"
  }
}
